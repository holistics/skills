{
  "description": "Validate AML files with the Holistics CLI after Claude writes or edits them",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/validate-aml.sh\"",
            "timeout": 10,
            "statusMessage": "Validating AML..."
          }
        ]
      }
    ]
  }
}